generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── User ────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN   // Propriétaire — accès total
  SELLER  // Vendeur — POS + clients uniquement
  CLIENT
}

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String
  password   String
  role       UserRole @default(CLIENT)
  phone      String?
  city       String?
  address    String?
  postalCode String?
  createdAt  DateTime @default(now())

  orders    Order[]
  cartItems CartItem[]
  favorites Favorite[]
}

// ─── Product ─────────────────────────────────────────────────────────────────

model Product {
  id          String        @id @default(cuid())
  name        String
  category    String
  price       Float
  stock       Int           @default(0)
  status      ProductStatus @default(DRAFT)
  mainImage   String        @default("")
  extraImages String        @default("[]") // JSON array as string
  createdAt   DateTime      @default(now())
  deletedAt   DateTime?     // null = active; non-null = soft-deleted

  sizes      ProductSize[]
  variants   Variant[]
  orderItems OrderItem[]
  cartItems  CartItem[]
  favorites  Favorite[]

  @@index([status, deletedAt])
}

model ProductSize {
  id        Int     @id @default(autoincrement())
  size      String
  quantity  Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
}

// ─── Variant (couleur → tailles) ─────────────────────────────────────────────

model Variant {
  id        String        @id @default(cuid())
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  color     String        // Ex: "Rouge", "Marine", "#3B82F6"
  sku       String?       // Ex: "PROD-RED-S-001"
  sizes     VariantSize[]

  @@unique([productId, color])
  @@index([productId])
}

model VariantSize {
  id        Int     @id @default(autoincrement())
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  variantId String
  name      String          // Ex: "S", "M", "42", "Sur mesure"
  stock     Int     @default(0)
  price     Float?          // null = hérite du prix de base du produit

  @@unique([variantId, name])
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

// ─── Order ───────────────────────────────────────────────────────────────────

enum OrderChannel {
  ONLINE   // commande en ligne
  OFFLINE  // vente en magasin (POS)
}

model Order {
  id            String       @id @default(cuid())
  user          User?        @relation(fields: [userId], references: [id])
  userId        String?
  channel       OrderChannel @default(ONLINE)
  total         Float
  status        OrderStatus  @default(PENDING)
  paymentMethod String       @default("cash")
  deliveryType  String       @default("home")

  // Snapshot adresse au moment de la commande.
  // city/address/postalCode sont nullable : les ventes OFFLINE (POS) ne
  // collectent pas d'adresse de livraison. Les commandes ONLINE les exigent
  // au niveau de la validation Zod (orderFormSchema).
  name       String
  phone      String
  email      String
  city       String?
  address    String?
  postalCode String?

  createdAt DateTime    @default(now())
  items     OrderItem[]

  @@index([userId])
  @@index([channel, userId])
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product? @relation(fields: [productId], references: [id])
  productId String?

  // Snapshot produit au moment de la commande
  name      String
  price     Float
  quantity  Int
  size      String?  // taille sélectionnée (null pour anciennes commandes)
  color     String?  // couleur variante sélectionnée (null si produit sans variantes)
  mainImage String
  category  String
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

// ─── Favorites (wishlist) ────────────────────────────────────────────────────

model Favorite {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

// ─── Cart ────────────────────────────────────────────────────────────────────

model CartItem {
  id        Int     @id @default(autoincrement())
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  quantity  Int     @default(1)
  size      String? // taille sélectionnée (null si pas de taille)
  color     String? // couleur variante sélectionnée (null si produit sans variantes)

  @@unique([userId, productId, size, color])
}
