generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String     @id @default(cuid())
  email      String     @unique
  name       String
  password   String
  role       UserRole   @default(CLIENT)
  phone      String?
  city       String?
  address    String?
  postalCode String?
  createdAt  DateTime   @default(now())
  cartItems  CartItem[]
  favorites  Favorite[]
  orders     Order[]
}

model Product {
  id          String         @id @default(cuid())
  name        String
  category    String
  price       Int
  stock       Int            @default(0)
  status          ProductStatus  @default(DRAFT)
  mainImage       String         @default("")
  createdAt       DateTime       @default(now())
  deletedAt       DateTime?
  discountPercent Int?
  isBestSeller    Boolean        @default(false)
  cartItems   CartItem[]
  favorites   Favorite[]
  orderItems  OrderItem[]
  extraImages ProductImage[]
  sizes       ProductSize[]
  variants    Variant[]
  lookProducts LookBookProduct[]

  @@index([status, deletedAt])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId String
  url       String
  color     String?
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([productId, color])
}

model ProductSize {
  id        Int     @id @default(autoincrement())
  size      String
  quantity  Int
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Variant {
  id        String        @id @default(cuid())
  productId String
  color     String
  sku       String?
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  sizes     VariantSize[]

  @@unique([productId, color])
  @@index([productId])
}

model VariantSize {
  id        Int     @id @default(autoincrement())
  variantId String
  name      String
  stock     Int     @default(0)
  price     Int?
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, name])
}

model Order {
  id            String       @id @default(cuid())
  userId        String?
  total         Int
  status        OrderStatus  @default(PENDING)
  paymentMethod String       @default("cash")
  deliveryType  String       @default("home")
  name          String
  phone         String
  email         String?
  city          String?
  address       String?
  postalCode    String?
  createdAt     DateTime     @default(now())
  channel       OrderChannel @default(ONLINE)
  user          User?        @relation(fields: [userId], references: [id])
  items         OrderItem[]
  returnSessions ReturnSession[]

  @@index([userId])
  @@index([channel, userId])
}

/// Session de retour Flowmerce (page hébergée). On conserve le token et sa date
/// d'expiration pour réutiliser le lien existant au lieu d'en régénérer un.
model ReturnSession {
  id          String   @id @default(cuid())
  orderId     String
  productName String
  token       String   @unique
  url         String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, productName])
  @@index([orderId])
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   String
  productId String?
  name      String
  price     Int
  quantity  Int
  mainImage String
  category  String
  color     String?
  size      String?
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id])
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

model LookBook {
  id          String   @id @default(cuid())
  title       String
  tag         String   @default("")
  description String   @default("")
  imageUrl    String
  accent      String   @default("#1a1713")
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  products    LookBookProduct[]
}

model LookBookProduct {
  id        Int      @id @default(autoincrement())
  lookId    String
  productId String
  sortOrder Int      @default(0)
  look      LookBook @relation(fields: [lookId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@index([lookId])
  @@index([productId])
}

model AuditLog {
  id       String   @id @default(cuid())
  actorId  String
  action   String
  entity   String
  entityId String
  diff     Json?
  at       DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@index([at])
}

model CartItem {
  id        Int      @id @default(autoincrement())
  userId    String
  productId String
  quantity  Int      @default(1)
  size      String?
  color     String?
  updatedAt DateTime @default(now()) @updatedAt
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, size, color])
  @@index([updatedAt])
}

enum UserRole {
  ADMIN
  CLIENT
  SELLER
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum OrderChannel {
  ONLINE
  OFFLINE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}
