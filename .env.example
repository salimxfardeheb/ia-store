# Database Configuration (PostgreSQL — Neon)
# DATABASE_URL is used by the app at runtime (pooled endpoint).
# DIRECT_URL is used by Prisma Migrate (direct, non-pooled endpoint).
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Authentication
# Secret key used for signing JWT tokens.
JWT_SECRET="your_jwt_secret_key_here"

# Site Configuration
# The base URL of the front-end application (used for CORS, CSRF, sitemaps, etc.).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Redis Cache & Rate Limiting (Upstash)
# Configuration for connection to Upstash Redis REST API.
UPSTASH_REDIS_REST_URL="https://your-redis-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token"

# Cloudinary (Media Uploads)
# Credentials used to sign server-side uploads of product images.
# Server-side only: the API secret must never be exposed to the browser.
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Cron Jobs Configuration
# Secret key to secure automated background endpoints (e.g. abandoned carts cron).
CRON_SECRET="your_cron_secret"

# Flowmerce Integration
# Credentials for third-party shipping/order syncing service Flowmerce.
# The API key identifies the seller account on its own — server-side only,
# it must never be exposed to the browser.
FLOWMERCE_API_KEY="your_flowmerce_api_key"
FLOWMERCE_BASE_URL="https://flowmerce.app"

# Proxy and Networking Configuration (Optional)
# Set to '1' if the application runs behind a reverse proxy (e.g. Nginx, Cloudflare) for correct IP rate limiting.
TRUST_PROXY="0"
