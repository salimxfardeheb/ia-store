# Database Configuration (PostgreSQL)
# Used by Prisma to connect to the database.
DATABASE_URL="postgresql://username:password@localhost:5432/ia_store?schema=public"

# Authentication
# Secret key used for signing JWT tokens.
JWT_SECRET="your_jwt_secret_key_here"

# Site Configuration
# The base URL of the front-end application (used for CORS, CSRF, sitemaps, etc.).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Redis Cache & Rate Limiting (Upstash)
# Configuration for connection to Upstash Redis REST API.
UPSTASH_REDIS_REST_URL="https://your-redis-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token"

# Cloudinary (Media Uploads)
# API credentials for storing and managing product images/media.
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Cron Jobs Configuration
# Secret key to secure automated background endpoints (e.g. abandoned carts cron).
CRON_SECRET="your_cron_secret"

# Flowmerce Integration
# Credentials for third-party shipping/order syncing service Flowmerce.
FLOWMERCE_API_KEY="your_flowmerce_api_key"
FLOWMERCE_BASE_URL="https://api.flowmerce.com"

# Proxy and Networking Configuration (Optional)
# Set to '1' if the application runs behind a reverse proxy (e.g. Nginx, Cloudflare) for correct IP rate limiting.
TRUST_PROXY="0"
